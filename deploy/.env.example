# Copy to .env and fill in. Never commit the real .env.

# REQUIRED — the JWT signing secret. Generate a strong random value, e.g.:
#   openssl rand -hex 32
# If this changes, all existing anonymous identities become invalid.
QUAPPE_SECRET=

# OPTIONAL — local LLM (Ollama) for pulse / translation / variant drafting.
# Leave blank to run without those features (they degrade gracefully).
OLLAMA_URL=
OLLAMA_MODEL=
