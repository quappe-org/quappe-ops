# Copy to .env and fill in. Never commit the real .env.

# REQUIRED — the JWT signing secret. Generate a strong random value, e.g.:
#   openssl rand -hex 32
# If this changes, all existing anonymous identities become invalid.
QUAPPE_SECRET=

# OPTIONAL — override the default LLM model (default: qwen2.5:3b).
# Smaller: qwen2.5:1.5b (~1.5GB RAM). Larger: qwen2.5:7b (~5GB RAM).
OLLAMA_MODEL=qwen2.5:3b
